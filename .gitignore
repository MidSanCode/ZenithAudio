migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

temp/
.owoTimeMachine/

# Rust build output (native/zenith_core). `Cargo.lock` is deliberately NOT
# ignored: this repo ships binaries, so the lockfile is part of the build
# contract and must be reviewed when dependencies change.
/target/
native/**/target/

# Native-assets hook output: the DLLs cargo produces for Flutter to bundle.
# Regenerated by `hook/build.dart` on every build.
/build/native_assets/
.dart_tool/hooks_runner/

# Agent-D isolated S3 verification harness (throwaway)
.s3-check/

# Throwaway verification harnesses. These mirror part of the real tree so a
# stage's files can be compiled and tested before the crate builds as a whole.
# They are scratch: they duplicate source already tracked under
# native/zenith_core/, and committing one is how 35 files of stale mirror
# source end up in the repository.
.s5check/
.s5-check/
.scratch/
.mycheck/

# 会话启动提示词：仅本地使用，不纳入版本库
docs/prompts/
